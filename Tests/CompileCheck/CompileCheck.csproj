<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Offline replica of SE2's (4.0.0.3151) in-game mod script compile (GameApp.AddScripting + GameScriptCodeProvider):
    the same metadata references, the same namespace whitelist (VRS1001), the same DCS / Library source
    generators and KCG analyzers, all taken from the game's own DLLs. It is NOT a unit-test suite: it tells
    you whether Scripts/Simulation and Scripts/Client would compile when the game loads the mod with -loadScripts.
    Copied from an earlier prototype's CompileCheck; extended to compile Client against Simulation's image.

    Run: Tests/CompileCheck/run.sh [Simulation|Client|all] [mod option] [dump-dir], see run.sh (the game DLLs need wine)
    Exit code 0 = compiles cleanly. Game2 can be overridden with the MSBuild property Game2 (dotnet run -p:Game2=...)
    The game targets net9.0; only the .NET 10 runtime is installed here, so RollForward=Major.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Game2 Condition="'$(Game2)' == ''">$(HOME)/.steam/debian-installation/steamapps/common/SpaceEngineers2/Game2</Game2>
  </PropertyGroup>
  <ItemGroup>
    <!-- ApiProbe/ is a mod tree that this tool compiles, not part of the tool. -->
    <Compile Remove="ApiProbe/**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Private=false: the game's DLLs are loaded from $(Game2) at run time (Program.cs resolver), never copied. -->
    <Reference Include="$(Game2)/VRage.Scripting.dll" Private="false" />
    <Reference Include="$(Game2)/VRage.Library.dll" Private="false" />
    <Reference Include="$(Game2)/VRage.Core.dll" Private="false" />
    <Reference Include="$(Game2)/VRage.Core.Game.dll" Private="false" />
    <Reference Include="$(Game2)/VRage.DCS.dll" Private="false" />
    <Reference Include="$(Game2)/VRage.Physics.dll" Private="false" />
    <Reference Include="$(Game2)/VRage.Multiplayer.dll" Private="false" />
    <Reference Include="$(Game2)/Game2.Simulation.dll" Private="false" />
    <Reference Include="$(Game2)/Game2.Client.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <!-- The game's own Roslyn DLLs are win-x64 ReadyToRun images that do not load on Linux (BadImageFormatException);
         the same version (4.14.0) from NuGet is used instead. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>Game2</_Parameter1>
      <_Parameter2>$(Game2)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
